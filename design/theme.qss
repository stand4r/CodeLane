/* =========================================================================
   PyScribe Workbench — rounded monochrome visual system
   -------------------------------------------------------------------------
   Metrics are intentionally uniform across the whole chrome so that texts,
   icons and hit-areas line up between widgets:

     MENU_BAR_H   30   top menu strip                      (font 12/13px)
     TITLE_BAR_H  40   custom title bar                    (app name 13px)
     ACTIVITY_BAR_W 46 (icon 20px, item 38x38)
     SIDEBAR_TITLE_H 35 (font 11px, uppercase, letter-spaced)
     LIST_ROW_H   22   explorer / search / git rows        (font 13px)
     TOOLBAR_BTN  24   explorer action buttons (icon 16px)
     EDITOR_TAB_H 35   editor tabs                         (font 13px)
     PANEL_TAB_H  35   terminal/problems/output tabs       (font 11px uppercase)
     STATUS_BAR_H 22   editor status strip                 (font 12px)

   Visual language: rounded controls, flat solid surfaces and fine borders.
   Subtle tonal differences distinguish controls without gradients.
   Theme colours are injected by app/styling.py by string replacement.
   ========================================================================= */

/* ---------- Typography: one base size everywhere ------------------------- */
* {
    font-size: 13px;
    font-weight: 400;
    outline: none;
}

QMainWindow, QDialog, QWidget {
    background: #181818;
    color: #CCCCCC;
}
QWidget::item { color: @glass_text@; }
QLabel { background: transparent; color: #CCCCCC; }

/* ---------- Workbench regions ------------------------------------------- */
QFrame#workbenchTopBar,
QFrame#activityBar,
QFrame#sidePanel,
QFrame#explorerHeader,
QWidget#settingsScroll,
QWidget#extensionsPanel,
QWidget#extensionsManager {
    background: #181818;
    color: #CCCCCC;
}
QFrame#activityBar { border-right: 1px solid #2B2B2B; }
QFrame#explorerHeader {
    min-height: 35px;
}

/* Text roles — only three sizes exist in the chrome. */
QLabel#appTitle { color: @glass_text@; font-size: 13px; font-weight: 600; }

/* Sidebar section title: VS Code "ПРОВОДНИК" style — 11px, uppercase, tracked */
QLabel#sideTitle,
QLabel#explorerSectionTitle {
    background: transparent;
    border: none;
    color: #BBBBBB;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1px;
}
QLabel#sideHint,
QLabel#emptySidePanel { color: #8C8C8C; font-size: 13px; }

QWidget#windowControls { background: transparent; border: none; }

/* ---------- Buttons ------------------------------------------------------ */
/* Generic tool buttons: flat, bordered only on hover, 24px tall. */
QToolButton {
    background: transparent;
    color: #CCCCCC;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 6px;
    min-height: 24px;
}
QToolButton:hover  { background: #2A2D2E; color: #E7E7E7; }
QToolButton:pressed,
QToolButton:checked { background: #37373D; color: @interaction_text@; }
QToolButton:disabled { color: #5A5A5A; }

/* Top bar menu buttons: exactly as VS Code (30px strip, 24px hits). */
QToolButton#workbenchMenuButton {
    min-height: 24px;
    max-height: 24px;
    padding: 0 8px;
    color: #CCCCCC;
    font-size: 13px;
    border-radius: 8px;
}

/* Native window controls (min / max / close) */
QToolButton#windowControl,
QToolButton#windowClose {
    padding: 0; margin: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
}
QToolButton#windowControl:hover { background: #2A2D2E; }
QToolButton#windowClose:hover { background: #E81123; color: #FFFFFF; }

/* Activity bar: 48px column, 48x48 hits, 24px icons, 2px left indicator */
QToolButton#activityAction {
    min-width: 38px; max-width: 38px;
    min-height: 38px; max-height: 38px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #868686;
}
QToolButton#activityAction:hover {
    background: transparent;
    color: @interaction_text@;
}
QToolButton#activityAction:checked {
    background: transparent;
    color: @interaction_text@;
}

/* Explorer toolbar: 24px flat icon buttons, 16px icons, no border */
QToolButton#explorerAction {
    min-width: 24px; max-width: 24px;
    min-height: 24px; max-height: 24px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #CCCCCC;
}
QToolButton#explorerAction:hover { background: #2A2D2E; color: @interaction_text@; }
QToolButton#explorerAction:pressed { background: #37373D; }

/* ---------- Explorer / lists -------------------------------------------- */
QTreeView#fileExplorer,
QListWidget,
QListWidget#extensionsList,
QListWidget#quickOpenList,
QListWidget#gitFiles,
QListWidget#extensionsManagerList {
    background: #181818;
    alternate-background-color: #181818;
    color: #CCCCCC;
    border: 0;
    outline: 0;
    font-size: 13px;
}
QTreeView#fileExplorer { show-decoration-selected: 0; }

/* Paint over the native row highlight in the indentation gutter. */
QTreeView#fileExplorer::item {
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
}
QTreeView#fileExplorer::item:hover { background: #2A2D2E; }
QTreeView#fileExplorer::item:selected { background: #04395E; color: #FFFFFF; }
QTreeView#fileExplorer::branch,
QTreeView#fileExplorer::branch:hover,
QTreeView#fileExplorer::branch:selected {
    background: #181818;
    border: 0;
}

QListWidget::item {
    min-height: 22px;
    padding: 0 8px;
    border: 0;
    border-radius: 0;
    background: transparent;
}
QListWidget::item:hover { background: #2A2D2E; }
QListWidget::item:selected { background: #04395E; color: #FFFFFF; }
QListWidget#extensionsList::item,
QListWidget#quickOpenList::item,
QListWidget#gitFiles::item,
QListWidget#extensionsManagerList::item {
    min-height: 22px;
    padding: 2px 8px;
    border-bottom: 1px solid #2B2B2B;
}

/* ---------- Inputs ------------------------------------------------------- */
/* Same 26px height everywhere; focused field gets a 1px accent ring. */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background: #313131;
    color: #CCCCCC;
    border: 1px solid #313131;
    border-radius: 8px;
    min-height: 26px;
    padding: 0 6px;
    font-size: 13px;
    selection-background-color: #04395E;
    selection-color: #FFFFFF;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover { border-color: #3C3C3C; }
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus { border-color: #007FD4; }
QLineEdit:disabled, QComboBox:disabled { color: #6E6E6E; }
QComboBox::drop-down { border: none; background: transparent; width: 24px; }
QComboBox::down-arrow { image: url(icons/chevron-down.png); width: 16px; height: 16px; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    background: transparent;
    width: 20px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(icons/chevron-up.png); width: 12px; height: 12px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(icons/chevron-down.png); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    selection-background-color: #04395E;
    selection-color: #FFFFFF;
    outline: none;
}

QPushButton {
    background: #313131;
    border: 1px solid #313131;
    color: #CCCCCC;
    border-radius: 8px;
    min-height: 26px;
    padding: 0 14px;
    font-size: 13px;
}
QPushButton:hover { background: #3A3A3A; border-color: #3A3A3A; }
QPushButton:pressed { background: #2A2A2A; color: #FFFFFF; }
QPushButton:disabled { background: #2A2A2A; color: #6E6E6E; }
QPushButton#primary {
    background: #0E639C;
    color: #FFFFFF;
    border: 1px solid #0E639C;
}
QPushButton#primary:hover { background: #1177BB; border-color: #1177BB; }
QPushButton#primary:pressed { background: #0D598D; }

QPushButton#gitCommitButton {
    background: #2EA043;
    color: #FFFFFF;
    border: 1px solid #2EA043;
}
QPushButton#gitCommitButton:hover { background: #3FB950; border-color: #3FB950; }
QPushButton#gitCommitButton:pressed { background: #238636; }

/* ---------- Editor tabs -------------------------------------------------- */
QTabWidget::pane {
    background: #1E1E1E;
    border: none;
}
QTabBar {
    background: #181818;
    qproperty-drawBase: 0;
    border: none;
    padding: 0;
}
QTabBar::tab {
    background: transparent;
    color: @muted_text@;
    border: none;
    border-radius: 5px;
    min-height: 29px;
    padding: 1px 10px;
    margin: 3px 2px;
    font-size: 13px;
    min-width: 80px;
}
QTabBar::tab:hover { background: @glass_hover@; color: @glass_text@; }
QTabBar::tab:selected {
    background: #37373D;
    color: @glass_text@;
}
QTabBar::close-button {
    image: url(icons/tab-close.svg);
    width: 16px; height: 16px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    margin-right: 2px;
    padding: 2px;
    border-radius: 6px;
    background: transparent;
}
QTabBar::close-button:hover { background: #454545; border-radius: 6px; }
QToolButton#editorTabAction,
QToolButton#editorRunDropdown {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0;
    min-height: 0;
}
QToolButton#editorTabAction:hover,
QToolButton#editorRunDropdown:hover,
QToolButton#editorRunDropdown:pressed { background: @glass_hover@; }
QToolButton#editorRunDropdown::menu-indicator { image: none; width: 0; }

QFrame#editorGroupPrimary,
QFrame#editorGroupSecondary,
QTabWidget#editorGroup::pane,
QTabWidget#editorGroupPrimary::pane,
QTabWidget#editorGroupSecondary::pane,
QPlainTextEdit,
QTextEdit#codeEditor {
    background: #1E1E1E;
    color: #D4D4D4;
    border: 0;
}
EnhancedTextEdit, QTextEdit#codeEditor {
    font-family: "@mono_font@", "Cascadia Code", "Consolas", monospace;
}

/* ---------- Splitters & status strip ------------------------------------- */
QSplitter::handle { background: @splitter_border@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: #0078D4; }

QLabel#editorStatusBar {
    background: transparent;
    color: #8C8C8C;
    font-size: 12px;
    min-height: 22px;
    max-height: 22px;
    padding: 0 8px;
}
QFrame#editorStatusBarFrame {
    background: #181818;
    border-top: 1px solid #2B2B2B;
    min-height: 24px;
    max-height: 24px;
}
QToolButton#lensToggleBtn,
QToolButton.statusActionBtn {
    background: transparent;
    color: #9D9D9D;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0 8px;
    font-size: 12px;
    min-height: 20px;
    max-height: 20px;
}
QToolButton#lensToggleBtn:hover,
QToolButton.statusActionBtn:hover { background: #2A2D2E; color: @interaction_text@; }
QToolButton.statusActionBtn::menu-indicator { image: none; width: 0; }

/* CodeLens / breadcrumb strip: same 22px row rhythm as the status strip */
QFrame#codeLensBar {
    background: @glass_surface@;
    border: none;
    border-bottom: 1px solid @soft_border@;
    min-height: 26px;
}
/* The widgets set a dynamic property `class="lensCrumbBtn"`, so the selector
   must use [class="..."]: `QToolButton.lensCrumbBtn` matches a C++ class name
   and never applied. That is why breadcrumb buttons kept the default raised
   background while the "›" dividers were transparent. */
QToolButton[class="lensCrumbBtn"],
QToolButton[class="lensActionBtn"] {
    background: transparent;
    color: #9D9D9D;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 6px;
    font-size: 12px;
    min-height: 20px;
    max-height: 20px;
}
QToolButton[class="lensCrumbBtn"]:hover,
QToolButton[class="lensActionBtn"]:hover { background: #343437; color: #FFFFFF; }
QToolButton[class="lensCrumbBtn"]:pressed,
QToolButton[class="lensActionBtn"]:pressed { background: #3D3D40; }
QLabel[class="lensDivider"] {
    color: #6E6E6E;
    font-size: 12px;
    padding: 0 2px;
    background: transparent;
}
QLabel#editorCenterStatus { color: #9D9D9D; font-size: 12px; }
QToolButton#syntaxStatusGood {
    color: #4EC9B0;
    font-size: 12px;
    padding: 0 6px;
    background: transparent;
    border: 1px solid #2B2B2B;
    border-radius: 8px;
    min-height: 18px;
    max-height: 18px;
}
QToolButton#syntaxStatusErr {
    color: #F14C4C;
    font-size: 12px;
    padding: 0 6px;
    background: transparent;
    border: 1px solid rgba(241, 76, 76, 0.45);
    border-radius: 8px;
    min-height: 18px;
    max-height: 18px;
}

/* Find / replace overlay: a compact toolbar docked to the editor top-right */
QFrame#findReplaceBar {
    background: #252526;
    border: 1px solid #454545;
    border-radius: 8px;
    margin: 4px 8px;
    padding: 3px 6px;
}
QFrame#findReplaceBar QLineEdit { min-height: 22px; max-height: 22px; }
QFrame#findReplaceBar QToolButton {
    min-width: 22px; max-width: 22px;
    min-height: 22px; max-height: 22px;
    padding: 0;
    border-radius: 8px;
    color: #CCCCCC;
}
QFrame#findReplaceBar QToolButton:checked { background: #04395E; color: #FFFFFF; }
QFrame#findReplaceBar QPushButton { min-height: 22px; max-height: 22px; padding: 0 8px; font-size: 12px; }
QFrame#findReplaceBar QLabel { color: #9D9D9D; font-size: 12px; }

/* ---------- Bottom panel (Терминал / Проблемы / Вывод) ------------------- */
QWidget#consoleWidget,
QTabWidget#consoleTabs,
QTabWidget#consoleTabs::pane,
QWidget#problemsPane,
QWidget#problemsWidget,
QFrame#panelToolbar {
    background: #181818;
    color: #CCCCCC;
    border: 0;
}
/* Panel tabs: one flat 35px strip shared with the editor tab bar height.
   Only the active tab gets a 1px accent underline — no pills, no borders. */
QTabWidget#consoleTabs QTabBar {
    background: #181818;
    padding: 0;
    border: none;
    border-bottom: 1px solid #2B2B2B;
}
QTabWidget#consoleTabs QTabBar::tab {
    background: transparent;
    color: #9D9D9D;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    min-height: 35px;
    max-height: 35px;
    min-width: 74px;
    padding: 0 12px;
    margin: 0;
    font-size: 11px;
    letter-spacing: 0;
}
QTabWidget#consoleTabs QTabBar::tab:hover { color: @interaction_text@; }
QTabWidget#consoleTabs QTabBar::tab:selected {
    background: transparent;
    color: #E7E7E7;
    border-bottom: 1px solid #0078D4;
}
QLabel#panelTitle {
    color: #BBBBBB;
    font-size: 11px;
    letter-spacing: 1px;
}
QLabel#panelContext { color: #8C8C8C; font-size: 12px; }
QFrame#panelToolbar { min-height: 30px; max-height: 30px; border-bottom: 1px solid #2B2B2B; }
QPushButton#panelToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #CCCCCC;
    font-size: 12px;
    min-height: 22px;
    max-height: 22px;
    padding: 0 8px;
}
QPushButton#panelToolButton:hover { background: #2A2D2E; border-color: transparent; }

/* Terminal: single-line strip with compact controls, no tab chrome in the
   common case (VS Code hides the terminal tab bar until you split). */
QTabWidget#terminalTabs QTabBar {
    background: #181818;
    padding: 0;
    border: none;
}
QTabWidget#terminalTabs QTabBar::tab {
    background: transparent;
    color: #9D9D9D;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
    margin: 0;
    font-size: 12px;
}
QTabWidget#terminalTabs QTabBar::tab:hover { color: @interaction_text@; }
QTabWidget#terminalTabs QTabBar::tab:selected {
    background: transparent;
    color: @interaction_text@;
    border-bottom: 1px solid #0078D4;
}
QWidget#terminalCorner,
QWidget#terminalCorner QWidget {
    background: #181818;
    border: none;
}
QToolButton#terminalShellButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #CCCCCC;
    font-size: 12px;
    padding: 0 8px;
    min-height: 22px;
    max-height: 22px;
}
QToolButton#terminalShellButton:hover { background: #2A2D2E; color: @interaction_text@; }
QToolButton#terminalTextAction,
QToolButton#terminalAction {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #9D9D9D;
    font-size: 12px;
    padding: 0 8px;
    min-height: 22px;
    max-height: 22px;
}
QToolButton#terminalTextAction:hover,
QToolButton#terminalAction:hover { background: #2A2D2E; color: @interaction_text@; }
QToolButton#terminalTextAction:pressed,
QToolButton#terminalAction:pressed { background: #37373D; }

QTextEdit#terminalScreen {
    background: #1E1E1E;
    color: #CCCCCC;
    border: none;
    padding: 2px 6px;
    font-family: "@mono_font@", "Cascadia Mono", "Consolas", monospace;
}
QLineEdit#terminalInput {
    background: transparent;
    color: #CCCCCC;
    border: 0;
    min-height: 22px;
    max-height: 22px;
    padding: 0 4px;
}

/* Completion popup: same surfaces as VS Code's suggest widget */
QListWidget#terminalCompletion {
    background: #252526;
    border: 1px solid #454545;
    border-radius: 6px;
    color: #CCCCCC;
    outline: none;
    padding: 2px;
    font-size: 13px;
}
QListWidget#terminalCompletion::item {
    min-height: 22px;
    max-height: 22px;
    padding: 0 6px;
    border-radius: 8px;
}
QListWidget#terminalCompletion::item:selected { background: #04395E; color: #FFFFFF; }

/* Problem counter sits on the panel strip */
QLabel#consoleBadge {
    background: #4D4D4D;
    color: #FFFFFF;
    border: none;
    border-radius: 9px;
    min-width: 18px;
    max-width: 60px;
    min-height: 18px;
    max-height: 18px;
    margin: 0;
    padding: 0 6px;
    font-size: 11px;
    font-weight: 400;
}

/* Panel strip actions (new terminal / stop / clear / hide) */
QWidget#consoleCorner { background: #181818; border: none; border-bottom: 1px solid #2B2B2B; }
QToolButton#consoleAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    margin: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}
QToolButton#consoleAction:hover { background: #2A2D2E; }
QToolButton#consoleAction:pressed { background: #37373D; }

QListWidget#problemsList {
    background: #1E1E1E;
    color: #CCCCCC;
    border: 0;
    font-size: 13px;
}
QListWidget#problemsList::item { min-height: 22px; padding: 0 8px; border-bottom: none; }
QListWidget#problemsList::item:selected { background: #04395E; color: #FFFFFF; }

/* ---------- AI agent panel (DeepSeek Harness / opencode style) ----------- */
QWidget#aiAgentPanel { background: #151517; border: none; }
QLabel#aiActivityLine {
    background: @glass_surface@;
    border: 0;
    border-left: 2px solid @glass_focus@;
    border-radius: 5px;
    padding: 5px 8px;
}

QLabel#aiHeaderTitle {
    color: @glass_text@;
    font-size: 14px;
    font-weight: 600;
}
QLabel#aiStatusDot { color: #E2B86B; font-size: 13px; padding: 0 4px; }
QToolButton#aiIconButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-width: 24px; max-width: 24px;
    min-height: 24px; max-height: 24px;
}
QToolButton#aiIconButton:hover { background: #2C2C2E; }
QToolButton#aiIconButton:pressed { background: #343436; }

QScrollArea#aiTranscript, QWidget#aiColumnHost { background: #151517; border: none; }
QTextBrowser#aiChat {
    background: #151517;
    color: #E7E7E7;
    border: none;
    font-size: 13px;
    padding: 0 8px;
    selection-background-color: #2C5A7A;
    selection-color: #FFFFFF;
}

/* User message bubble embedded in the transcript */
QWidget#aiUserBubble { background: #151517; }
QFrame#aiUserBubblePill {
    background: #2C2C2E;
    border: none;
    border-radius: 16px;
}
QLabel#aiUserBubbleText {
    background: transparent;
    color: #EDEDED;
    font-size: 13px;
}

/* Quick actions: quiet text chips above the composer */
QWidget#aiActionsHost { background: #151517; }
QPushButton#aiQuickAction {
    background: transparent;
    border: 1px solid #2A2A2C;
    border-radius: 12px;
    color: #A0A0A2;
    font-size: 12px;
    min-height: 22px;
    max-height: 22px;
    padding: 0 10px;
}
QPushButton#aiQuickAction:hover { background: #232325; border-color: #3A3A3C; color: #E7E7E7; }
QPushButton#aiQuickAction:pressed { background: #2C2C2E; }

/* Quick actions: quiet text chips above the composer */
QWidget#aiActionsHost { background: #151517; }
QPushButton#aiQuickAction {
    background: transparent;
    border: 1px solid #2A2A2C;
    border-radius: 12px;
    color: #A0A0A2;
    font-size: 12px;
    min-height: 22px;
    max-height: 22px;
    padding: 0 10px;
}
QPushButton#aiQuickAction:hover { background: #232325; border-color: #3A3A3C; color: #E7E7E7; }
QPushButton#aiQuickAction:pressed { background: #2C2C2E; }

/* Floating composer */
QWidget#aiComposerWrap { background: #151517; }
QFrame#aiComposer {
    background: #1F1F22;
    border: 1px solid #353539;
    border-radius: 18px;
}
QFrame#aiComposer:hover { border-color: #404046; }
QPlainTextEdit#aiInput {
    background: transparent;
    color: #EDEDED;
    border: none;
    border-radius: 0;
    padding: 2px 4px;
    font-size: 13.5px;
    selection-background-color: #2C5A7A;
    selection-color: #FFFFFF;
}
QPlainTextEdit#aiInput:focus { border: none; }

QToolButton#aiAttachButton {
    min-width: 34px;
    min-height: 32px;
    padding: 0;
    font-size: 22px;
}

/* Composer toolbar: only the send (and transient stop) button are visible.
   All secondary actions live in the right-click menu (QMenu#aiContextMenu). */
QMenu#aiContextMenu {
    background: #252526;
    border: 1px solid #3A3A3C;
    border-radius: 8px;
    padding: 5px;
}
QToolButton#aiSendButton {
    background: #2F6FEB;
    border: none;
    border-radius: 15px;
    padding: 0;
    margin: 0;
}
QToolButton#aiSendButton:hover { background: #3B82F6; }
QToolButton#aiSendButton:pressed { background: #2660CC; }
QToolButton#aiSendButton:disabled { background: #313134; }
QToolButton#aiStopButton {
    background: #3A3A3C;
    border: none;
    border-radius: 15px;
    padding: 0;
    margin: 0;
}
QToolButton#aiStopButton:hover { background: #4A4A4C; }
QLabel#aiStatusLine { color: @chat_warning@; font-size: 11px; padding: 0 2px 2px 2px; }
/* Session metrics under the composer (answers · steps · tok/s · tokens · cache) */
QLabel#aiStatsLine {
    color: #AAAAAD;
    font-size: 11px;
    background: transparent;
    padding: 0 4px 2px 4px;
}

/* Queued messages hint inside the composer */
QLabel#aiQueueChip {
    color: #8FB4D9;
    font-size: 11px;
    background: rgba(61, 111, 168, 0.18);
    border: 1px solid rgba(71, 122, 181, 0.45);
    border-radius: 9px;
    padding: 2px 8px;
    margin: 2px 2px 0 2px;
}

/* ---- Chat messages ------------------------------------------------------ */
/* Assistant answers are flat text on the panel background (IDE style); only
   the user's message gets a compact pill. No tails, no gradients. */
QWidget#aiUserBubble, QWidget#aiAssistantBubble { background: transparent; }
QFrame#aiAssistantBubbleBody {
    background: transparent;
    border: none;
}
QFrame#aiUserBubblePill {
    background: #2A2A2C;
    border: 1px solid #333335;
    border-radius: 14px;
}
QLabel#aiUserBubbleText {
    color: #F0F0F0;
    font-size: 13.5px;
    background: transparent;
}
QLabel#aiAssistantBubbleText {
    background: transparent;
    border: none;
    color: #E6E6E8;
    font-size: 13.5px;
    selection-background-color: #2C5A7A;
    selection-color: #FFFFFF;
}


/* ---- Assistant message: rounded inline chips + editor-backed code -------- */
QWidget#chatCodeSnippet {
    background: #18181B;
    border: 1px solid #2E2E32;
    border-radius: 8px;
}
QFrame#chatCodeHeader {
    background: #202024;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #2E2E32;
    min-height: 28px;
    max-height: 28px;
}
QLabel#chatCodeLanguage {
    color: #8B949E;
    font-size: 12px;
    background: transparent;
}
QToolButton#chatCodeCopy {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: #8B949E;
    font-size: 12px;
    padding: 2px 8px;
}
QToolButton#chatCodeCopy:hover {
    background: #2C2C30;
    border-color: #3A3A3E;
    color: #E6E6E8;
}
QPlainTextEdit#chatCodeView {
    background: #18181B;
    color: #D4D4D4;
    border: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    selection-background-color: #2C5A7A;
    selection-color: #FFFFFF;
}
/* Hover actions under an assistant answer */
QWidget#aiMessageActions { background: transparent; }
QToolButton#aiMessageAction {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #8A8A8E;
    font-size: 11px;
    padding: 1px 7px;
}
QToolButton#aiMessageAction:hover {
    background: #232325;
    border-color: #323234;
    color: #D8D8DA;
}

/* Toolbar / step chips inside the chat */
QLabel#aiChatHint {
    color: #6E6E70;
    font-size: 11.5px;
    background: transparent;
}

/* Chat body: a readable sans stack, slightly larger than the UI font */
QTextBrowser#aiChat {
    font-size: 13.5px;
}
QTextBrowser#aiChat pre {
    font-family: "@mono_font@", "Consolas", monospace;
    font-size: 12.5px;
}

/* Context scope + agent mode + model pickers inside the composer */
QToolButton#aiScopeButton,
QToolButton#aiModeButton,
QToolButton#aiModelButton {
    background: transparent;
    border: 1px solid #3A3A3C;
    border-radius: 11px;
    color: #A0A0A2;
    font-size: 11px;
    padding: 0 8px;
    margin: 0;
    min-height: 22px;
    max-height: 22px;
}
QToolButton#aiScopeButton:hover,
QToolButton#aiModeButton:hover,
QToolButton#aiModelButton:hover { background: #343436; color: #E7E7E7; border-color: #4A4A4C; }
QToolButton#aiScopeButton::menu-indicator,
QToolButton#aiModeButton::menu-indicator,
QToolButton#aiModelButton::menu-indicator { image: none; width: 0; }
QToolButton#aiModelButton { color: #E7E7E7; }
/* The tutor mode is deliberately quiet but distinguishable. */
QToolButton#aiModeButton[teach="true"] {
    color: #7FB3E8;
    border-color: #3D5A78;
    background: rgba(61, 111, 168, 0.16);
}
QLabel#aiModeBadge {
    color: #7FB3E8;
    background: rgba(61, 111, 168, 0.16);
    border: 1px solid #3D5A78;
    border-radius: 8px;
    font-size: 10px;
    padding: 1px 7px;
    margin-left: 6px;
}

QListWidget#aiCompletion {
    background: #252526;
    border: 1px solid #454545;
    border-radius: 6px;
    color: #CCCCCC;
    outline: none;
    padding: 3px;
    font-size: 12px;
}
QListWidget#aiCompletion::item { min-height: 20px; padding: 0 6px; border-radius: 8px; }
QListWidget#aiCompletion::item:selected { background: #3A3A3C; color: #FFFFFF; }

QGroupBox#aiMcpGroup {
    border: 1px solid #2B2B2B;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    color: #CCCCCC;
}

/* ---------- Menus -------------------------------------------------------- */
QMenu {
    background: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 4px 0;
    font-size: 13px;
}
QMenu::item {
    min-height: 18px;
    padding: 0 28px 0 26px;
    border-radius: 0;
    margin: 0;
}
QMenu::item:selected { background: #04395E; color: #FFFFFF; }
QMenu::item:disabled { color: #6E6E6E; }
QMenu::separator { height: 1px; background: #454545; margin: 4px 8px; }
QMenu::indicator { width: 16px; height: 16px; left: 6px; }

QToolTip {
    background: #252526;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 4px 6px;
    font-size: 12px;
}

/* ---------- Project intelligence / graph -------------------------------- */
QWidget#projectIntelligence,
QWidget#projectGraphEditor { background: #181818; color: #CCCCCC; }
QFrame#intelligenceHeader,
QFrame#graphEditorHeader,
QFrame#graphEditorToolbar { background: #181818; border-bottom: 1px solid #2B2B2B; min-height: 35px; }
QLabel#intelligenceTitle,
QLabel#graphEditorTitle { color: #CCCCCC; font-size: 13px; font-weight: 400; }
QLabel#intelligenceStatus,
QLabel#graphEditorSubtitle,
QLabel#graphEditorStatus { color: #8C8C8C; font-size: 12px; }
QFrame#intelligenceMetric {
    background: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 8px;
}
QLabel#intelligenceMetricValue { color: #CCCCCC; font-size: 18px; }
QLabel#intelligenceMetricLabel { color: #8C8C8C; font-size: 11px; }
QWidget#projectIntelligence QTreeWidget,
QWidget#projectIntelligence QLineEdit,
QWidget#projectGraphEditor QLineEdit,
QWidget#projectGraphEditor QComboBox {
    background: #313131;
    color: #CCCCCC;
    border: 1px solid #313131;
    border-radius: 8px;
    font-size: 13px;
}
QWidget#projectIntelligence QTreeWidget::item { min-height: 22px; }
QWidget#projectIntelligence QTreeWidget::item:hover { background: #2A2D2E; }
QWidget#projectIntelligence QTreeWidget::item:selected { background: #04395E; color: #FFFFFF; }
QGraphicsView#projectGraphView { background: #1E1E1E; border: 1px solid #2B2B2B; border-radius: 8px; }
QToolButton#analysisProfile {
    text-align: left;
    background: #252526;
    color: #CCCCCC;
    border: 1px solid #2B2B2B;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 13px;
}
QToolButton#analysisProfile:hover { background: #2A2D2E; }
QToolButton#analysisProfile:checked { background: #04395E; border-color: #007FD4; color: #FFFFFF; }

/* ---------- Settings, Git, documents ------------------------------------ */
QFrame#gitPanel,
QFrame#gitCard,
QFrame#gitRemoteCard,
QGroupBox#analyzerGroup,
QWidget#documentViewer,
QFrame#shortcutGroup {
    background: #181818;
    color: #CCCCCC;
    border-color: #2B2B2B;
    border-radius: 8px;
}
QWidget#documentViewer QTableWidget,
QWidget#documentViewer QTextBrowser { background: #1E1E1E; color: #CCCCCC; gridline-color: #2B2B2B; }
QLabel#documentStatus,
QLabel#pdfPage { background: #181818; color: #8C8C8C; font-size: 12px; }
QGroupBox {
    border: 1px solid #2B2B2B;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    font-size: 13px;
}
QGroupBox::title {
    color: #CCCCCC;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    font-size: 13px;
}

/* ---------- Generic controls -------------------------------------------- */
QCheckBox, QRadioButton { color: #CCCCCC; spacing: 6px; font-size: 13px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QHeaderView::section {
    background: #252526;
    color: #CCCCCC;
    border: 0;
    border-right: 1px solid #2B2B2B;
    padding: 4px 8px;
    min-height: 22px;
    font-size: 12px;
}
QProgressBar {
    background: #313131;
    border: none;
    border-radius: 8px;
    min-height: 6px;
    text-align: center;
    color: #CCCCCC;
}
QProgressBar::chunk { background: #0078D4; border-radius: 8px; }
QStatusBar#statusBar { background: transparent; border: none; min-height: 0; max-height: 0; height: 0; }
QStatusBar::item { border: 0; }

QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #424242; min-width: 24px; border-radius: 0; }
QScrollBar::handle:horizontal:hover { background: #4F4F4F; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- Welcome ------------------------------------------------------ */
QWidget#Main { background: #1E1E1E; }
QFrame#welcomeAction {
    background: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 8px;
}
QFrame#welcomeAction:hover { background: #2A2D2E; border-color: #007FD4; }
QFrame#welcomeAction:hover QLabel { background: transparent; color: @interaction_text@; }
QLabel#welcomeTitle { color: #CCCCCC; font-size: 24px; font-weight: 300; }
QLabel#welcomeShortcut {
    color: #9D9D9D;
    background: #313131;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 1px 5px;
    font-size: 11px;
}
QToolButton:disabled, QPushButton:disabled, QLabel:disabled { color: #6E6E6E; }
QTabBar::tab:focus, QTreeView#fileExplorer::item:focus { outline: none; }

/* ---------- Settings / project dialogs ---------------------------------- */
QGroupBox#intelligenceActions {
    background: #181818;
    border: 1px solid #2B2B2B;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox#intelligenceActions::title {
    color: #CCCCCC;
    background: transparent;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}
QWidget#projectIntelligence QLabel, QWidget#projectIntelligence QGroupBox { background: transparent; }
QWidget#projectIntelligence QGroupBox#intelligenceActions QPushButton {
    background: #313131;
    color: #CCCCCC;
    border: 1px solid #313131;
    border-radius: 8px;
    min-height: 26px;
    padding: 0 10px;
}
QWidget#projectIntelligence QGroupBox#intelligenceActions QPushButton:hover {
    background: #3A3A3A;
    border-color: #3A3A3A;
}
QWidget#projectIntelligence QFrame#intelligenceMetric { background: #252526; border-radius: 8px; }
QWidget#projectIntelligence QFrame#intelligenceMetric QLabel { background: transparent; }

QDialog#projectManager QFrame#projectRow {
    background: @glass_surface@;
    border: 1px solid transparent;
    border-radius: 7px;
}
QDialog#projectManager QFrame#projectRow:hover {
    background: @glass_hover@;
}
QDialog#projectManager QFrame#projectRow[selected="true"] {
    border-color: @glass_focus@;
}
QLabel#projectRowName, QLabel#projectRowPath { background: transparent; }
QLabel#projectRowName { font-weight: 600; }
QLabel#projectRowPath { color: #9D9D9D; font-size: 12px; }

QFrame#welcomeProject QLabel,
QLabel#welcomeProjectName,
QLabel#welcomeProjectPath,
QLabel#welcomeProjectTime {
    background: transparent;
    border: none;
}

/* ---------- About -------------------------------------------------------- */
QDialog#aboutDialog { background: #181818; border: 1px solid #2B2B2B; border-radius: 8px; }
QDialog#aboutDialog QLabel#aboutTitle { font-size: 22px; font-weight: 300; color: #CCCCCC; }
QDialog#aboutDialog QLabel#aboutBadge {
    background: #313131;
    color: #CCCCCC;
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 8px;
}
QDialog#aboutDialog QLabel#aboutTagline { font-size: 13px; color: #CCCCCC; }
QDialog#aboutDialog QLabel#aboutDesc { color: #CCCCCC; font-size: 13px; }
QDialog#aboutDialog QFrame#aboutFeaturesCard {
    background: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 8px;
}
QDialog#aboutDialog QLabel#aboutFeatureText { color: #8C8C8C; font-size: 12px; }
QDialog#aboutDialog QLabel#aboutFeatureIcon { font-size: 14px; }
QDialog#aboutDialog QLabel#aboutCopyright { color: #8C8C8C; font-size: 11px; }

/* ---------- Loading overlay & spinners ----------------------------------- */
QWidget#loadingOverlay { background: rgba(18, 18, 18, 200); }
QFrame#loadingCard {
    background: #252526;
    border: 1px solid #454545;
    border-radius: 6px;
}
QFrame#loadingCard QLabel { background: transparent; }

/* Rounded, flat chrome. Surface tokens adapt to the selected theme. */
QFrame#aiHeader {
    border: none;
    border-bottom: 1px solid @soft_border@;
}
QPushButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    border-radius: 8px;
}
QToolButton#aiAccessMode {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 13px;
    min-height: 24px;
    max-height: 24px;
    padding: 0 10px;
    font-size: 12px;
}
QToolButton#aiAccessMode:hover, QToolButton#aiAccessMode:open {
    background: @glass_hover@;
    border-color: @glass_focus@;
}
QToolButton#aiAccessMode:focus { border-color: @glass_focus@; }
QToolButton#aiAccessMode::menu-indicator { image: none; width: 0; }
QToolButton#aiIconButton, QToolButton#explorerAction,
QToolButton#terminalAction, QToolButton#terminalShellButton,
QToolButton#terminalTextAction, QFrame#workbenchTopBar QToolButton,
QToolButton[class="lensActionBtn"], QToolButton[class="lensCrumbBtn"] {
    border-radius: 8px;
}
QToolButton#windowControl, QToolButton#windowClose { border-radius: 8px; }
QMenu, QMenu#aiContextMenu, QMenu#aiAccessMenu {
    background: @glass_menu@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item { border-radius: 7px; padding: 6px 26px; margin: 1px 0; }
QMenu::item:selected { background: @glass_hover@; color: @glass_text@; }
QMenu::separator { background: @glass_border@; margin: 5px 10px; }
QFrame#aiComposer {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 12px;
}
QWidget#agentWorkspacePanel { background: @glass_surface@; border: none; }
QLabel#agentWorkspaceTitle { color: @glass_text@; font-size: 15px; font-weight: 600; }
QLabel#agentPlannerTitle { color: @glass_text@; font-weight: 600; }
QLabel#agentWorkspaceStats { color: @glass_text@; padding: 2px 4px; }
QLabel#agentGraphEmpty { color: #90959e; background: transparent; border: none; }
QGraphicsView#agentGraph { background: transparent; border: none; }
QWidget#agentPlanner { background: transparent; border-top: 1px solid @glass_border@; padding-top: 8px; }
QTreeWidget#agentPlannerTree { background: transparent; border: none; outline: none; }
QListWidget#agentTaskQueue { background: @glass_surface@; border: 1px solid @glass_border@; border-radius: 6px; }
QListWidget#agentTaskQueue::item { padding: 6px 8px; }
QListWidget#agentTaskQueue::item:selected { background: @glass_hover@; color: @glass_text@; }
QTreeWidget#agentPlannerTree::item { padding: 5px 6px; border-radius: 5px; }
QTreeWidget#agentPlannerTree::item:hover, QTreeWidget#agentPlannerTree::item:selected {
    background: @glass_hover@; color: @glass_text@;
}
QToolButton#agentPlannerAdd,
QPushButton#agentStopButton, QPushButton#agentChangesButton {
    background: @glass_surface@; color: @glass_text@; border: 1px solid @glass_border@;
    border-radius: 6px; padding: 5px 9px; min-height: 18px;
}
QToolButton#agentPlannerAdd:hover,
QPushButton#agentStopButton:hover, QPushButton#agentChangesButton:hover {
    background: @glass_hover@;
}
QToolButton#agentPlannerAdd {
    font-size: 18px; font-weight: 600; padding: 5px 9px; min-width: 42px; max-width: 42px;
}
QPushButton#agentStopButton:disabled { color: #777a80; }
QToolButton#aiScopeButton, QToolButton#aiModeButton, QToolButton#aiModelButton {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    color: @glass_text@;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { border-radius: 4px; }
QTreeView#fileExplorer::item, QListWidget::item { border-radius: 5px; }
QPushButton:focus, QToolButton:focus { border: 1px solid @glass_focus@; }

QToolButton#activityAction {
    border-radius: 12px;
    border: 1px solid transparent;
}
QToolButton#activityAction:hover { background: @glass_hover@; }
QToolButton#activityAction:checked {
    background: @glass_surface@;
    border-color: @glass_border@;
}
QToolTip {
    background: @glass_menu@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
    padding: 6px 10px;
}
QProgressBar, QProgressBar::chunk { border-radius: 4px; }

/* Sidebar controls share the workbench palette and fit narrow columns. */
QWidget#searchPanel, QScrollArea#gitScroll, QWidget#gitContent, QWidget#gitFooter {
    background: #181818;
    border: none;
}
QWidget#searchPanel QLineEdit {
    background: #242424;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 24px;
}
QWidget#searchPanel QToolButton {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 7px;
    padding: 0 5px;
}
QWidget#searchPanel QToolButton:hover { background: @glass_hover@; }
QWidget#searchPanel QToolButton:checked {
    background: @glass_hover@;
    border-color: @glass_focus@;
}
QTreeWidget#searchResults {
    background: #181818;
    color: @glass_text@;
    border: none;
    padding: 2px;
}
QTreeWidget#searchResults::item { padding: 4px; min-height: 22px; border-radius: 5px; }
QTreeWidget#searchResults::item:hover,
QTreeWidget#searchResults::item:selected { background: @glass_hover@; color: @glass_text@; }
QFrame#gitAuthCard, QFrame#gitRemoteCard, QFrame#githubTokenGuide {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 10px;
}
QWidget#gitContent QPushButton, QWidget#gitFooter QPushButton {
    min-height: 28px;
    padding: 2px 8px;
}
QWidget#gitContent QLineEdit, QWidget#gitFooter QLineEdit { min-height: 28px; }

/* Comfortable hit areas for Git header actions; QSS follows UI scaling. */
QToolButton#gitAction {
    min-width: 34px; max-width: 34px;
    min-height: 34px; max-height: 34px;
    icon-size: 20px;
    padding: 0;
    margin: 0 2px;
    border: 1px solid @glass_border@;
    border-radius: 9px;
    background: @glass_surface@;
}
QToolButton#gitAction:hover { background: @glass_hover@; }
QToolButton#gitAction:pressed, QToolButton#gitAction:open { border-color: @glass_focus@; }
QToolButton#gitAction::menu-indicator { image: none; width: 0; }

/* Project analysis is one scrollable surface. */
QFrame#analysisSection {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
}
QWidget#projectIntelligence QWidget#analysisSectionContent {
    background: transparent;
}
QWidget#projectIntelligence QTreeWidget {
    background: @glass_surface@;
    alternate-background-color: @glass_hover@;
}
QWidget#projectIntelligence QHeaderView::section {
    background: @glass_hover@;
    color: @glass_text@;
    border-color: @glass_border@;
}
QLabel#analysisSectionTitle {
    color: @glass_text@;
    font-weight: 600;
}
QFrame#analysisMetric {
    background: @glass_hover@;
    border-radius: 5px;
}

/* Analyzer profiles share one panel with flat, separated groups of checks. */
QWidget#analysisChooser, QWidget#analysisChooser QWidget {
    font-size: 13px;
}
QWidget#analysisChooser QLabel#analysisChooserTitle {
    font-size: 23px;
    font-weight: 600;
    color: @glass_text@;
}
QWidget#analysisChooser QLabel#analysisChooserHint {
    font-size: 12px;
    color: #A8A8A8;
    background: transparent;
}
QWidget#analysisChooser QLabel#analysisChooserSection {
    font-size: 13px;
    font-weight: 600;
    color: @glass_text@;
    background: transparent;
}
QWidget#analysisChooser QLabel#analysisChecksTitle {
    font-size: 13px;
    font-weight: 600;
    color: @glass_text@;
}
QWidget#analysisChooser QFrame#analysisChecksPanel {
    border: 1px solid @glass_border@;
    border-radius: 8px;
    background: @glass_surface@;
}
QWidget#analysisChooser QFrame#analysisGroupDivider {
    border: none;
    background: @glass_border@;
}
QWidget#analysisChooser QScrollArea,
QWidget#analysisProfilePage,
QWidget#analysisProfileContent,
QWidget#analysisProfileGroup {
    background: transparent;
    border: none;
}
QWidget#analysisChooser QComboBox#analysisProfilePicker {
    background: @glass_hover@;
    border: 1px solid @glass_border@;
    border-radius: 6px;
}
QWidget#analysisChooser QComboBox#analysisProfilePicker:focus {
    border-color: @glass_focus@;
}
QWidget#analysisChooser QComboBox#analysisProfilePicker QAbstractItemView {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    selection-background-color: @glass_hover@;
    selection-color: @glass_text@;
}
QWidget#analysisChooser QCheckBox {
    color: @glass_text@;
    background: transparent;
    font-weight: 500;
    spacing: 7px;
    padding: 2px 0;
}
QWidget#analysisChooser QPushButton {
    min-height: 32px;
    padding: 2px 16px;
}

QWidget#aiAgentPanel,
QWidget#aiTranscript,
QWidget#aiColumnHost,
QWidget#aiChatColumn,
QWidget#aiComposerWrap {
    background: @ai_panel_background@;
}
QPlainTextEdit#aiInput {
    color: @glass_text@;
}
QToolButton#aiAccessMode,
QToolButton#aiScopeButton,
QToolButton#aiModelButton {
    padding-left: 8px;
    padding-right: 8px;
}

QWidget#analysisChooser QCheckBox::indicator:unchecked {
    width: 12px;
    height: 12px;
    border: 1px solid @glass_border@;
    background: transparent;
}
QWidget#analysisChooser QCheckBox::indicator:unchecked { border-radius: 3px; }
QWidget#analysisChooser QCheckBox:focus { color: @glass_focus@; }

/* ---- Update / Explorer integration dialogs ------------------------------- */
QDialog#updateDialog, QDialog#shellIntegrationDialog {
    background: @glass_menu@;
}
QLabel#updateTitle {
    font-size: 18px;
    font-weight: 600;
    color: @glass_text@;
}
QLabel#updateVersion {
    font-size: 12px;
    color: #8B949E;
}
QLabel#updateStatus {
    font-size: 12px;
    color: #8B949E;
}
QTextBrowser#updateNotes {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
    padding: 8px;
    color: @glass_text@;
    font-size: 13px;
}
QPushButton#updateAction {
    background: @glass_focus@;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 600;
}
QPushButton#updateAction:hover { background: @glass_focus@; }
QPushButton#updateAction:disabled { background: @glass_border@; color: #8B949E; }

/* ---- PDF viewer ----------------------------------------------------------- */
QWidget#pdfToolbar {
    background: @glass_menu@;
    border-bottom: 1px solid @glass_border@;
}
QToolButton#pdfTool {
    color: @glass_text@;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 12px;
    min-height: 24px;
}
QToolButton#pdfTool:hover { background: @glass_hover@; border-color: @glass_border@; }
QToolButton#pdfTool:pressed { background: @glass_border@; }
QToolButton#pdfTool:disabled { color: #5E5E62; }
QFrame#pdfSeparator { color: @glass_border@; }
QSpinBox#pdfPageSpin, QComboBox#pdfZoomCombo, QLineEdit#pdfSearch {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 6px;
    color: @glass_text@;
    padding: 1px 6px;
    min-height: 24px;
    font-size: 12px;
}
QSpinBox#pdfPageSpin:focus, QComboBox#pdfZoomCombo:focus, QLineEdit#pdfSearch:focus {
    border-color: @glass_focus@;
}
QLabel#pdfTotal { color: #8B949E; font-size: 12px; padding: 0 4px; }
QScrollArea#pdfScroll { background: #141416; border: none; }
QWidget#pdfCanvas { background: #141416; }
QLabel#pdfPage { background: #FFFFFF; border: 1px solid #3A3A3F; }
QLabel#pdfStatus {
    color: #8B949E;
    font-size: 12px;
    padding: 3px 10px;
    border-top: 1px solid @glass_border@;
    background: @glass_menu@;
}

QLabel#markdownTitle {
    font-size: 15px;
    font-weight: 600;
    color: @glass_text@;
}
QWidget#markdownViewer QToolButton {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
    padding: 3px 8px;
    color: @glass_text@;
}
QWidget#markdownViewer QToolButton:hover,
QWidget#markdownViewer QToolButton:checked {
    background: @glass_hover@;
}
QTextBrowser#markdownBrowser,
QTreeWidget#markdownOutline {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 10px;
}
QTextBrowser#markdownBrowser {
    background: @markdown_paper@;
    color: @markdown_text@;
}
QTreeWidget#markdownOutline::item {
    min-height: 25px;
    padding: 0 4px;
}
QTreeWidget#markdownOutline::item:selected {
    background: @glass_hover@;
    color: @glass_text@;
}


QScrollArea#browserHomeScroll {
    border: none;
}
QLineEdit#browserHomeSearch {
    background: #f4f6f7;
    color: #263741;
    border: 2px solid #d8e2e5;
    border-radius: 25px;
    min-height: 38px;
    max-height: 38px;
    padding: 5px 14px;
    font-size: 16px;
}
QLineEdit#browserHomeSearch:focus { border-color: #85b3c6; }
QToolButton#browserShortcutTile {
    background: transparent;
    color: #edf4f7;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 4px;
}
QToolButton#browserShortcutTile:hover,
QToolButton#browserShortcutTile:focus {
    background: rgba(25, 49, 61, 135);
    border-color: rgba(212, 231, 238, 90);
}
QTabBar#browserTabs::tab {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid transparent;
    border-radius: 8px;
    margin: 0 3px 0 0;
    padding: 0 10px;
    min-width: 74px;
    max-width: 175px;
    min-height: 28px;
    max-height: 28px;
}
QTabBar#browserTabs::tab:selected {
    background: @glass_hover@;
    border-color: @glass_border@;
}
QLineEdit#browserAddress {
    background: #242424;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 10px;
    padding: 5px 10px;
}
QLineEdit#browserAddress:focus { border-color: @glass_focus@; }
QToolButton#browserAction {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
    min-height: 26px;
    min-width: 24px;
    padding: 2px 6px;
}
QToolButton#browserAction:hover { background: @glass_hover@; }

QToolButton#browserNav {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    min-width: 28px;
    min-height: 27px;
    padding: 2px;
}
QToolButton#browserNav:hover {
    background: @glass_hover@;
    border-color: @glass_border@;
}

QToolButton#browserProfile {
    background: @glass_surface@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 14px;
    min-height: 27px;
    padding: 2px 10px 2px 7px;
}
QToolButton#browserProfile:hover, QToolButton#browserProfile:open {
    background: @glass_hover@;
    border-color: @glass_focus@;
}
QToolButton#browserProfile::menu-indicator { width: 9px; subcontrol-position: right center; }
QMenu#browserProfileMenu { min-width: 178px; }

/* Settings workbench */
QWidget#settingsWorkbench {
    background: #181818;
}
QLabel#settingsTitle {
    font-size: 23px;
    font-weight: 600;
    color: @glass_text@;
    padding: 3px 0;
}
QListWidget#settingsNavigation,
QStackedWidget#settingsPages,
QFrame#settingsFooter {
    background: #181818;
    border: none;
}
QListWidget#settingsNavigation {
    color: @glass_text@;
    padding: 5px 8px 5px 0;
    border-right: 1px solid @soft_border@;
    outline: 0;
}
QListWidget#settingsNavigation::item {
    min-height: 24px;
    padding: 3px 8px;
    border-radius: 7px;
}
QListWidget#settingsNavigation::item:disabled {
    color: #A8A8A8;
    font-size: 10px;
    padding-top: 9px;
}
QListWidget#settingsNavigation::item:selected,
QListWidget#settingsNavigation::item:hover:enabled {
    background: @glass_hover@;
    color: @glass_text@;
}
QScrollArea#settingsPageScroll,
QWidget#settingsPageContent {
    background: #181818;
    border: none;
}
QLabel#settingsPageTitle {
    color: @glass_text@;
    font-weight: 600;
    font-size: 19px;
}
QLabel#settingsSectionTitle {
    color: @glass_text@;
    font-weight: 600;
    font-size: 14px;
    border-bottom: 1px solid @glass_border@;
    padding: 8px 0 4px;
}
QWidget#settingsWorkbench QLabel#settingsHint {
    color: #A8A8A8;
    font-size: 12px;
}
QFrame#settingsFooter QPushButton {
    min-height: 30px;
    padding: 2px 16px;
}
QFrame#settingsFooter { border-top: 1px solid @soft_border@; }

/* Database tabs share the editor surface. The splitter and header own the separators. */
QWidget#databaseWorkbench QTableView {
    background: #1E1E1E;
    border: none;
    selection-background-color: #264F78;
}
QWidget#databaseWorkbench QHeaderView {
    background: #181818;
}
QWidget#databaseWorkbench QHeaderView::section {
    background: #181818;
    color: @glass_text@;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid @soft_border@;
}
QWidget#databaseWorkbench QHeaderView::section:vertical {
    border-bottom: none;
    border-right: 1px solid @soft_border@;
}
QWidget#databaseWorkbench QTableCornerButton::section {
    background: #181818;
    border: none;
}

QWidget#workbenchMenuStrip { background: transparent; }
QToolButton#workbenchMenuButton {
    background: transparent;
    color: @glass_text@;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 6px;
}
QToolButton#workbenchMenuButton:hover,
QToolButton#workbenchMenuButton:open {
    background: @glass_hover@;
    border-color: @glass_border@;
}
QToolButton#workbenchMenuButton::menu-indicator { image: none; width: 0; }
QFrame#omniSearchPill {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 8px;
}
QFrame#omniSearchPill:hover { background: @glass_hover@; }
QFrame#omniSearchPill:focus { border-color: @glass_focus@; }
QLabel#omniSearchPrompt { background: transparent; color: @glass_text@; }
QLabel#omniSearchShortcut {
    background: transparent;
    color: @muted_text@;
    border: none;
    padding: 0 4px;
    font-size: 11px;
}
QToolButton#topAgentToggle {
    color: @glass_text@;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    min-height: 28px;
    padding: 0 8px;
}
QToolButton#topAgentToggle:hover,
QToolButton#topAgentToggle:pressed { background: @glass_hover@; border-color: @glass_border@; }
QToolButton#topAgentToggle:focus { border-color: @glass_focus@; }
QMenu#workbenchPopup::item { padding: 5px 16px; }
QLabel#workbenchMenuSection {
    background: transparent;
    color: #A8A8A8;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 16px 2px;
}

/* Refined workbench surfaces and interaction states. */
QFrame#workbenchSeparator { background: @glass_border@; border: none; }
QFrame#activityBar { border-right: 1px solid @soft_border@; }
QFrame#explorerHeader { border-bottom: 1px solid @soft_border@; }
QWidget#agentWorkspace { background: #181818; }
QSplitter#agentWorkspaceSplit::handle { background: @soft_border@; }
QSplitter#agentWorkspaceSplit::handle:hover { background: @glass_focus@; }
QTabBar#editorTabs::tab {
    margin: 3px 1px 0 1px;
    min-width: 48px;
    border: 1px solid transparent;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
QTabBar#editorTabs::tab:selected {
    background: #1E1E1E;
    border-color: @soft_border@;
    border-bottom-color: @tab_indicator@;
}
QFrame#aiHeader {
    background: @glass_surface@;
    border-bottom: 1px solid @soft_border@;
}
QFrame#aiComposer {
    background: @glass_surface@;
    border: 1px solid @glass_border@;
    border-radius: 14px;
}
QFrame#aiComposer:hover { border-color: @muted_text@; }
QFrame#aiComposer[inputFocused="true"] { border-color: @glass_focus@; }
QPlainTextEdit#aiInput { color: @glass_text@; }
QFrame#aiUserBubblePill {
    background: @glass_hover@;
    border: 1px solid @glass_border@;
    border-radius: 13px;
}
QLabel#aiUserBubbleText, QLabel#aiAssistantBubbleText { color: @glass_text@; }
QTextBrowser#chatRichText, QPlainTextEdit#chatCodeView {
    selection-background-color: #264F78;
    selection-color: @glass_text@;
}
QWidget#chatCodeSnippet {
    background: #1E1E1E;
    border: 1px solid @glass_border@;
    border-radius: 10px;
}
QFrame#chatCodeHeader {
    background: @glass_hover@;
    border-bottom: 1px solid @glass_border@;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}
QLabel#chatCodeLanguage { color: @glass_text@; font-weight: 600; }
QToolButton#chatCodeCopy { color: @glass_text@; }
QToolButton#chatCodeCopy:hover, QToolButton#chatCodeCopy:focus {
    color: @glass_text@;
    background: @glass_surface@;
    border-color: @glass_border@;
}
QPlainTextEdit#chatCodeView {
    background: #1E1E1E;
    color: @glass_text@;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
QGraphicsView#agentGraph {
    background: @glass_menu@;
    border: 1px solid @soft_border@;
    border-radius: 8px;
}
QLabel#agentGraphEmpty, QLabel#agentWorkspaceStats { color: @muted_text@; }
QLabel#sideTitle, QLabel#explorerSectionTitle {
    letter-spacing: 0px;
    font-size: 12px;
    font-weight: 500;
    color: @muted_text@;
}
QPushButton {
    border: 1px solid @soft_border@;
    border-radius: 8px;
    padding: 5px 12px;
    background: @glass_surface@;
    color: @glass_text@;
}
QPushButton:hover { background: @glass_hover@; border-color: @glass_border@; }
QPushButton:pressed { background: #37373D; }
QPushButton:focus { border-color: @glass_focus@; }
QPushButton:disabled { color: @muted_text@; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid @soft_border@;
    border-radius: 7px;
    padding: 4px 8px;
    selection-background-color: #264F78;
    selection-color: @interaction_text@;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: @glass_focus@;
}
QComboBox { padding-right: 26px; }
QGroupBox {
    border: 1px solid @soft_border@;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: @muted_text@;
}
QTreeView, QListView { outline: 0; border: none; }
QTreeView::item, QListView::item { border-radius: 5px; padding: 2px 4px; }
QTreeView::item:hover, QListView::item:hover { background: @glass_surface@; }
QMenu { border: 1px solid @glass_border@; border-radius: 7px; padding: 5px 5px 7px; }
QMenu#workbenchPopup { border: 1px solid @glass_border@; border-radius: 6px; padding: 5px 5px 7px; }
QMenu::item { border-radius: 5px; padding: 6px 18px; }
QMenu::separator { height: 1px; background: @soft_border@; margin: 5px 8px; }
QToolTip {
    background: @glass_menu@;
    color: @glass_text@;
    border: 1px solid @glass_border@;
    border-radius: 6px;
    padding: 6px 9px;
}

/* Agent workspace: a quiet canvas, one floating composer and a separate activity rail. */
QWidget#agentWorkspace, QWidget#agentWorkspaceSidebar, QWidget#aiAgentPanel, QWidget#aiTranscript,
QWidget#aiColumnHost, QWidget#aiChatColumn, QWidget#aiComposerWrap,
QWidget#aiComposerRow {
    background: @agent_canvas@; border: none;
}
QFrame#aiHeader { background: @agent_canvas@; border: none; }
QLabel#aiHeaderTitle { font-size: 15px; color: @glass_text@; }
QLabel#agentWelcomeTitle { font-size: 27px; font-weight: 600; color: @glass_text@; background: transparent; }
QPushButton#agentWelcomeAction {
    background: @agent_panel@; color: @glass_text@; border: 1px solid @agent_edge@;
    border-radius: 15px; padding: 6px 13px;
}
QPushButton#agentWelcomeAction:hover, QPushButton#agentWelcomeAction:focus {
    background: @agent_tint@; border-color: @agent_accent@;
}
QFrame#aiComposer { background: @agent_card@; border: 1px solid @agent_composer_edge@; border-radius: 21px; }
QPlainTextEdit#aiComposerInput { background: transparent; border: none; color: @glass_text@; font-size: 12px; }
QFrame#aiComposer:hover { border-color: @muted_text@; }
QFrame#aiComposer[inputFocused="true"] { border-color: @agent_accent@; }
QToolButton#aiAccessMode, QToolButton#aiScopeButton, QToolButton#aiModelButton,
QToolButton#aiAttachButton { background: transparent; color: @glass_text@; border: none; border-radius: 10px; }
QToolButton#aiScopeButton:hover, QToolButton#aiModelButton:hover, QToolButton#aiAccessMode:hover,
QToolButton#aiAttachButton:hover { background: @agent_tint@; }
QFrame#aiUserBubblePill { background: @agent_tint@; border: none; border-radius: 17px; }
QLabel#aiActivityLine { background: @agent_panel@; border: none; border-radius: 10px; padding: 5px 10px; }
QWidget#chatCodeSnippet { background: @agent_panel@; border: 1px solid @agent_edge@; border-radius: 13px; }
QFrame#chatCodeHeader { background: @agent_card@; border-bottom: none; border-top-left-radius: 12px; border-top-right-radius: 12px; }
QPlainTextEdit#chatCodeView { background: @agent_panel@; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
QSplitter#agentWorkspaceSplit::handle { background: @agent_canvas@; }
QSplitter#agentWorkspaceSplit::handle:hover { background: @agent_edge@; }
QFrame#agentWorkspacePanel { background: @agent_panel@; border: 1px solid @agent_edge@; border-radius: 19px; }
QLabel#agentWorkspaceTitle { background: transparent; color: @glass_text@; font-size: 17px; font-weight: 600; }
QLabel#agentWorkspaceActivity { background: transparent; color: @muted_text@; border: none; }
QFrame#agentProgressDot { background: @agent_accent@; border: none; border-radius: 3px; }
QGraphicsView#agentGraph, QWidget#agentStageGuide { background: transparent; border: none; }
QLabel#agentStageHeading { background: transparent; color: @glass_text@; font-weight: 600; }
QLabel#agentStageHint, QLabel#agentWorkspaceStats { background: transparent; color: @muted_text@; }
QFrame#agentStageDot { background: @agent_accent@; border: none; border-radius: 4px; }
QWidget#agentPlanner { border-top: 1px solid @agent_edge@; }
QPushButton#agentStopButton, QPushButton#agentChangesButton, QPushButton#agentJournalButton {
    background: @agent_card@; border: 1px solid @agent_edge@; border-radius: 13px; padding: 4px 11px;
}
QPushButton#agentJournalButton:hover { background: @agent_tint@; }
QPushButton#agentStopButton:disabled, QPushButton#agentJournalButton:disabled {
    background: transparent; color: @muted_text@; border-color: @agent_edge@;
}
